<configuration>
  <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
    <withJansi>true</withJansi>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>
        [%d{HH:mm:ss} %highlight(%level)]: %msg%n
        <!--                %d{yyyy-MM-dd HH:mm:ss} - %magenta(%level) - %cyan(%logger) - %yellow(%msg%n)-->
      </pattern>
    </encoder>
  </appender>

  <logger name="com.harriswebstudio.router" level="INFO" />

  <root level="INFO">
    <appender-ref ref="Console"/>
  </root>

</configuration>
